from tenacity import retry, stop_after_attempt, wait_exponential, retry_if_exception_type
import requests
from curl_cffi import requests as cffi_requests # 用于伪造 TLS 指纹

# 自定义异常，当遇到 429 或 503 时触发重试
class RateLimitError(Exception):
    pass

@retry(
    stop=stop_after_attempt(5), # 最多重试 5 次
    wait=wait_exponential(multiplier=1, min=2, max=10), # 指数退避：2s, 4s, 8s...
    retry=retry_if_exception_type(RateLimitError)
)
def fetch_data(url):
    # 使用 curl_cffi 模拟 Chrome 120 的 TLS 指纹
    response = cffi_requests.get(url, impersonate="chrome120", timeout=10)
    
    if response.status_code == 429 or response.status_code == 503:
        print("触发速率限制或 5 秒盾，等待重试...")
        raise RateLimitError("Rate limited")
    
    if response.status_code == 200:
        return response.text
    
    return None
